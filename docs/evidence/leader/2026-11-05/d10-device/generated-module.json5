{
  "module": {
    "name": "entry",
    "type": "entry",
    "srcEntry": "./ets/qabilitystage/QAbilityStage.ets",
    "description": "LDraw model editor for HarmonyOS PC",
    "mainElement": "QAbility",
    "deviceTypes": ["2in1", "tablet"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "QAbility",
        "srcEntry": "./ets/qability/QAbility.ets",
        "launchType": "specified",
        "description": "$string:QAbility_desc",
        "icon": "$media:leocad",
        "label": "$string:QAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "isolationProcess": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home",
              "ohos.want.action.sendData",
            ],
            "uris": [
              {
                "scheme": "file",
                "utd": "general.text",
                "maxFileSupported": 10
              },
              {
                "scheme": "file",
                "utd": "general.png",
                "maxFileSupported": 10
              },
              {
                "scheme": "file",
                "utd": "general.jpeg",
                "maxFileSupported": 10
              },
            ]
          }
        ],
        "metadata": [
          {
            "name": 'enable.remove.starting.window',
            "value": 'true'
          }
        ],
        "continuable": true
      }
    ],
    "requestPermissions": [
        {
            "name": "ohos.permission.STORE_PERSISTENT_DATA"
        },
        {
            "name": "ohos.permission.FILE_ACCESS_PERSIST"
        },
        {
            "name": "ohos.permission.PREPARE_APP_TERMINATE"
        },
        {
            "name": "ohos.permission.READ_PASTEBOARD",
            "reason": "$string:qt_permission_reason_read_pasteboard",
            "usedScene": {
                "abilities": [
                    "QAbility"
                ],
                "when": "always"
            }
        },
        {
            "name": "ohos.permission.GET_FILE_ICON"
        },
        {
            "name": "ohos.permission.PRINT"
        }
    ]
  }
}
