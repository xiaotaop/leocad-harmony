diff --git a/leocad.pro b/leocad.pro
index c4a8f215..e7a26bac 100644
--- a/leocad.pro
+++ b/leocad.pro
@@ -171,6 +171,21 @@ ios {
 	DEFINES += LC_DISABLE_BLENDER=1
 }
 
+# Qt 6.12 ships mkspecs/ohos-clang, whose qmake.conf sets QMAKE_PLATFORM = ohos,
+# so "ohos" is the scope name qmake matches for HarmonyOS builds.
+ohos {
+	# The first release is fully offline and does not request the INTERNET
+	# permission. Without this define, lcDoInitialUpdateCheck() (qt/qtmain.cpp)
+	# requests https://www.leocad.org/updates.txt on startup, which would break
+	# that claim and show a network error on a device with no connectivity.
+	DEFINES += LC_DISABLE_UPDATE_CHECK=1
+
+	# External rendering and the render dialog are out of first-release scope;
+	# the menu entries are removed by lcMainWindow::ApplyFirstReleaseScope().
+	DEFINES += LC_DISABLE_RENDER_DIALOG=1
+	DEFINES += LC_DISABLE_BLENDER=1
+}
+
 SOURCES += \
 	common/camera.cpp \
 	common/group.cpp \
diff --git a/qt/qtmain.cpp b/qt/qtmain.cpp
index ace3239e..debca8d4 100644
--- a/qt/qtmain.cpp
+++ b/qt/qtmain.cpp
@@ -2,6 +2,7 @@
 #include "lc_application.h"
 #include "lc_updatedialog.h"
 #include "lc_profile.h"
+#include "lc_library.h"
 #include "pieceinf.h"
 #include <QApplication>
 #include <locale.h>
@@ -205,6 +206,14 @@ int main(int argc, char *argv[])
 	LibraryPaths += qMakePair(QString::fromLatin1(LC_LDRAW_LIBRARY_PATH), false);
 #endif
 
+	// The parts library that ships inside the application package. Placed after
+	// LC_LDRAW_LIBRARY_PATH so an explicitly configured path still takes
+	// precedence, and before Initialize() consumes the list. Marked official so
+	// the piece count is recorded (lcPiecesLibrary::SetOfficialPieces()).
+	const QString BundledLibrary = lcPiecesLibrary::FindBundledLibraryArchive();
+	if (!BundledLibrary.isEmpty())
+		LibraryPaths += qMakePair(BundledLibrary, true);
+
 	setlocale(LC_NUMERIC, "C");
 
 	lcStartupMode StartupMode = Application.Initialize(LibraryPaths);
