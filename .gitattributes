# Set the default behavior, in case people don't have core.autocrlf set.
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.cpp text
*.h text

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary

# Preserve original device-evidence bytes so receipt SHA-256 values survive checkout.
/docs/evidence/leader/2026-10-27/d2-device-pass/* -text whitespace=cr-at-eol
# Native log lines include trailing spaces; retain them for the receipt hashes.
/docs/evidence/leader/2026-10-28/d3-device/* -text whitespace=cr-at-eol,-blank-at-eol
